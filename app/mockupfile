    function getActivePageEl() {
      if (activePageEl && document.body.contains(activePageEl)) return activePageEl;
      activePageEl = document.querySelector('.a4-page.active-page') || document.querySelector('.a4-page');
      return activePageEl;
    }

    function saveHistory() {
      const workspaceHTML = document.getElementById('workspace').innerHTML;
      if (undoStack.length && undoStack[undoStack.length - 1] === workspaceHTML) return;
      undoStack.push(workspaceHTML);
      if (undoStack.length > MAX_HISTORY) undoStack.shift();
      redoStack.length = 0;
    }

    function undo() {
      if (undoStack.length <= 1) return;
      const current = undoStack.pop();
      redoStack.push(current);
      const prev = undoStack[undoStack.length - 1];
      document.getElementById('workspace').innerHTML = prev;
      rebindAllEvents();
    }

    function redo() {
      if (!redoStack.length) return;
      const next = redoStack.pop();
      undoStack.push(next);
      document.getElementById('workspace').innerHTML = next;
      rebindAllEvents();
    }

