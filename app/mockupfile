      insertBeforeClosingPage(section);
    }

    function insertBeforeClosingPage(section) {
      const workspace = document.getElementById('workspace');
      const pages = workspace.querySelectorAll('.a4-page');
      const lastPage = pages[pages.length - 1];
      if (lastPage && lastPage.innerText.includes('THANK YOU')) {
        workspace.insertBefore(section, lastPage);
      } else {
        workspace.appendChild(section);
      }

      updatePageNumbers();
      rebindAllEvents();
      setActivePage(section);
      section.scrollIntoView({ behavior: 'smooth', block: 'center' });
      saveHistory();
    }

    function updatePageNumbers() {
      const pages = document.querySelectorAll('.a4-page');
      const total = String(pages.length).padStart(2, '0');
      pages.forEach((p, idx) => {
        const num = String(idx + 1).padStart(2, '0');
        p.dataset.page = idx + 1;
        const numEl = p.querySelector('.page-num');
        const totEl = p.querySelector('.page-total');
        if (numEl) numEl.innerText = num;
        if (totEl) totEl.innerText = total;
      });
    }

    // =====================================================
    // 6. LABEL CEPAT & GAMBAR BEBAS (DRAG, RESIZE, DROP)
    // =====================================================
    function addQuickLabel(text, targetPage = null, x = null, y = null) {
      const page = targetPage || getActivePageEl();
      if (!page) return;
      const layer = page.querySelector('.freeform-layer');
      if (!layer) return;

      const offset = (layer.children.length * 22) % 160;
      const posX = x !== null ? x : 130 + offset;
      const posY = y !== null ? y : 120 + offset;

      const item = document.createElement('div');
      item.className = 'canvas-item';
      item.dataset.type = 'label';
      item.style.left = `${posX}px`;
      item.style.top = `${posY}px`;
      item.style.fontSize = '13px';

      item.innerHTML = `
        <div class="canvas-label-text" contenteditable="true" spellcheck="false">${text}</div>
        <div class="delete-badge" onclick="removeCanvasItem(this, event)">✕</div>
      `;

      layer.appendChild(item);
      bindDraggable(item);
      selectElement(item);
      saveHistory();
    }

    function addImageToCanvas(dataUrl, targetPage = null, x = null, y = null, w = 360) {
      const page = targetPage || getActivePageEl();
      if (!page) return;
      const layer = page.querySelector('.freeform-layer');
      if (!layer) return;

      const defaultX = 160 + ((layer.children.length * 28) % 240);
      const defaultY = 140 + ((layer.children.length * 24) % 140);

      const item = document.createElement('div');
      item.className = 'canvas-item';
      item.dataset.type = 'image';
      item.style.left = `${x !== null ? Math.max(20, x - w / 2) : defaultX}px`;
      item.style.top = `${y !== null ? Math.max(20, y - 100) : defaultY}px`;
      item.style.width = `${w}px`;

      item.innerHTML = `
        <img src="${dataUrl}" class="w-full h-auto block pointer-events-none select-none rounded" />
        <div class="resize-handle"></div>
        <div class="delete-badge" onclick="removeCanvasItem(this, event)">✕</div>
      `;

      layer.appendChild(item);
      bindDraggable(item);
      selectElement(item);
      saveHistory();
    }

    function removeCanvasItem(btn, e) {
      e.stopPropagation();
      const item = btn.closest('.canvas-item');
      if (item) {
        item.remove();
        deselectAll();
        saveHistory();
      }
    }

    function selectElement(el) {
      deselectAll();
      selectedElement = el;
      el.classList.add('selected');
      const inspector = document.getElementById('floating-inspector');
      inspector.classList.remove('hidden');
      inspector.classList.add('flex');
    }

    function deselectAll() {
      document.querySelectorAll('.canvas-item.selected').forEach(el => el.classList.remove('selected'));
      selectedElement = null;
      const inspector = document.getElementById('floating-inspector');
      inspector.classList.add('hidden');
      inspector.classList.remove('flex');
    }

    function changeSelectedFontSize(delta) {
      if (!selectedElement || selectedElement.dataset.type !== 'label') return;
      const current = parseInt(window.getComputedStyle(selectedElement).fontSize, 10) || 13;
      const next = Math.min(52, Math.max(9, current + delta));
      selectedElement.style.fontSize = `${next}px`;
      saveHistory();
    }

    function deleteSelectedItem() {
      if (!selectedElement) return;
      selectedElement.remove();
      deselectAll();
      saveHistory();
    }

    function copySelectedItem() {
      if (!selectedElement) return;
      internalClipboard = {
        html: selectedElement.outerHTML,
        left: parseInt(selectedElement.style.left, 10) || 120,
        top: parseInt(selectedElement.style.top, 10) || 120
      };
    }

    function pasteInternalItem() {
      if (!internalClipboard) return false;
      const page = getActivePageEl();
      const layer = page?.querySelector('.freeform-layer');
      if (!layer) return false;
      const wrapper = document.createElement('div');
      wrapper.innerHTML = internalClipboard.html;
      const clone = wrapper.firstElementChild;
      clone.style.left = `${internalClipboard.left + 24}px`;
      clone.style.top = `${internalClipboard.top + 24}px`;
      layer.appendChild(clone);
      bindDraggable(clone);
      selectElement(clone);
      saveHistory();
      return true;
    }

    function bindDraggable(el) {
      let isDragging = false;
      let isResizing = false;
      let startX = 0, startY = 0;
      let origLeft = 0, origTop = 0, origWidth = 0;

      el.onmousedown = function(e) {
        e.stopPropagation();
        const pageSection = el.closest('.a4-page');
        if (pageSection) setActivePage(pageSection);
        selectElement(el);

        if (e.target.classList.contains('delete-badge')) return;

        if (e.target.classList.contains('resize-handle')) {
          isResizing = true;
          startX = e.clientX;
          origWidth = el.offsetWidth;
          document.onmousemove = onMove;
          document.onmouseup = onUp;
          return;
        }

        if (document.activeElement === e.target && e.target.isContentEditable) {
          return;
        }

        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        origLeft = parseInt(el.style.left, 10) || 0;
        origTop = parseInt(el.style.top, 10) || 0;

        document.onmousemove = onMove;
        document.onmouseup = onUp;
      };

      function onMove(e) {
        if (isDragging) {
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;
          el.style.left = `${origLeft + dx}px`;
          el.style.top = `${origTop + dy}px`;
        } else if (isResizing) {
          const dx = e.clientX - startX;
          const newWidth = Math.max(50, origWidth + dx);
          el.style.width = `${newWidth}px`;
        }
      }

      function onUp() {
        if (isDragging || isResizing) {
          saveHistory();
        }
        isDragging = false;
        isResizing = false;
        document.onmousemove = null;
        document.onmouseup = null;
      }
    }

    // =====================================================
    // 7. DRAG & DROP GAMBAR APAPUN LANGSUNG KE HALAMAN
    // =====================================================
    function bindPageDropZone(pageEl) {
      pageEl.ondragover = function(e) {
        e.preventDefault();
        e.stopPropagation();
        pageEl.classList.add('drag-over');
      };

      pageEl.ondragleave = function(e) {
        e.preventDefault();
        e.stopPropagation();
        pageEl.classList.remove('drag-over');
      };

      pageEl.ondrop = function(e) {
        e.preventDefault();
        e.stopPropagation();
        pageEl.classList.remove('drag-over');
        setActivePage(pageEl);

        const rect = pageEl.getBoundingClientRect();
        const dropX = e.clientX - rect.left;
        const dropY = e.clientY - rect.top;

        const files = Array.from(e.dataTransfer?.files || []);
        if (files.length > 0) {
          files.forEach((file, idx) => {
            const reader = new FileReader();
            reader.onload = ev => {
              if (ev.target.result) {
                addImageToCanvas(ev.target.result, pageEl, dropX + idx * 25, dropY + idx * 25, 340);
              }
            };
            reader.readAsDataURL(file);
          });
          return;
        }

        const htmlData = e.dataTransfer?.getData('text/html');
        if (htmlData) {
          const doc = new DOMParser().parseFromString(htmlData, 'text/html');
          const img = doc.querySelector('img');
          if (img && img.src) {
            addImageToCanvas(img.src, pageEl, dropX, dropY, 340);
            return;
          }
        }

        const uri = e.dataTransfer?.getData('text/uri-list') || e.dataTransfer?.getData('text/plain');
        if (uri && (uri.startsWith('http') || uri.startsWith('data:image'))) {
          addImageToCanvas(uri, pageEl, dropX, dropY, 340);
        }
      };
    }

    function rebindAllEvents() {
      document.querySelectorAll('.canvas-item').forEach(el => bindDraggable(el));
      document.querySelectorAll('.a4-page').forEach(pageEl => bindPageDropZone(pageEl));
    }

    // =====================================================
    // 8. UPLOAD FOTO, BACKGROUND & SHORTCUT KEYBOARD
    // =====================================================
    function handlePhotoUpload(e) {
      const files = Array.from(e.target.files || []);
      const targetPage = getActivePageEl();
      files.forEach((file, idx) => {
        const reader = new FileReader();
        reader.onload = ev => {
          addImageToCanvas(ev.target.result, targetPage, 340 + idx * 30, 240 + idx * 25, 340);
        };
        reader.readAsDataURL(file);
      });
      e.target.value = '';
    }

    function handleBgUpload(e) {
      const file = e.target.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = ev => {
        document.querySelectorAll('.page-bg-image').forEach(bg => {
          bg.style.backgroundImage = `url('${ev.target.result}')`;
        });
        saveHistory();
      };
      reader.readAsDataURL(file);
      e.target.value = '';
    }

    function updateBgOpacity(val) {
      const op = Number(val) / 100;
      document.querySelectorAll('.page-bg-image').forEach(bg => {
        bg.style.opacity = op;
      });
    }

    function clearCustomBg() {
      document.querySelectorAll('.page-bg-image').forEach(bg => {
        bg.style.backgroundImage = 'none';
      });
      saveHistory();
    }

    window.addEventListener('keydown', e => {
      const isEditingText = document.activeElement && document.activeElement.isContentEditable;

      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && !e.shiftKey) {
        if (!isEditingText) {
          e.preventDefault();
          undo();
        }
      }
      if ((e.ctrlKey || e.metaKey) && (e.key.toLowerCase() === 'y' || (e.shiftKey && e.key.toLowerCase() === 'z'))) {
        if (!isEditingText) {
          e.preventDefault();
          redo();
        }
      }
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'c') {
        if (!isEditingText && selectedElement) {
          e.preventDefault();
          copySelectedItem();
        }
      }
      if ((e.key === 'Delete' || e.key === 'Backspace') && !isEditingText && selectedElement) {
        e.preventDefault();
        deleteSelectedItem();
      }
    });

    window.addEventListener('paste', e => {
      const isEditingText = document.activeElement && document.activeElement.isContentEditable;
      const items = e.clipboardData?.items || [];

      for (const item of items) {
        if (item.type.indexOf('image') !== -1) {
          e.preventDefault();
          const blob = item.getAsFile();
          const reader = new FileReader();
          reader.onload = ev => {
            addImageToCanvas(ev.target.result, getActivePageEl());
          };
          reader.readAsDataURL(blob);
          return;
        }
      }

      if (!isEditingText && internalClipboard) {
        e.preventDefault();
        pasteInternalItem();
      }
    });

    // =====================================================
    // 9. RENDERER PDF PRESISI 100% (ANTI-POTONG & ANTI-MIRING)
    // =====================================================
    async function exportCleanPDF() {
      const btn = document.getElementById('btn-export-pdf');
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = `<span>Merender PDF...</span>`;

      deselectAll();
      if (document.activeElement) document.activeElement.blur();

      try {
        await document.fonts.ready;
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({
          orientation: 'landscape',
          unit: 'mm',
          format: 'a4',
          compress: true
        });

        const pages = document.querySelectorAll('.a4-page');

        const stage = document.createElement('div');
        stage.className = 'exporting-clean';
        stage.style.cssText = 'position:fixed; left:-99999px; top:0; width:1123px; height:794px; margin:0; padding:0; z-index:-1; overflow:hidden;';
        document.body.appendChild(stage);

        for (let i = 0; i < pages.length; i++) {
          stage.innerHTML = '';
          const clone = pages[i].cloneNode(true);
          clone.style.transform = 'none';
          clone.style.margin = '0';
          clone.style.width = '1123px';
          clone.style.height = '794px';
          stage.appendChild(clone);

          const canvas = await html2canvas(clone, {
            scale: 2,
            useCORS: true,
            allowTaint: true,
            backgroundColor: '#ffffff',
            width: 1123,
            height: 794,
            windowWidth: 1123,
            windowHeight: 794,
            scrollX: 0,
            scrollY: 0
          });

          const imgData = canvas.toDataURL('image/jpeg', 0.96);
          if (i > 0) pdf.addPage('a4', 'landscape');
          pdf.addImage(imgData, 'JPEG', 0, 0, 297, 210);
        }

        document.body.removeChild(stage);
        pdf.save(`MOLUSCA_PREVIEW_PERTAMINA_PATRA_NIAGA.pdf`);
      } catch (err) {
        console.error('PDF Render Error:', err);
        window.print();
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    }

    // =====================================================
    // 10. INISIALISASI AWAL
    // =====================================================
    window.addEventListener('DOMContentLoaded', () => {
      preloadLogoAsBase64();
      rebindAllEvents();

      const page5Barang1 = document.querySelector('.a4-page[data-page="5"]');
      const page6Barang2 = document.querySelector('.a4-page[data-page="6"]');

      // Label default pada halaman Mockup Barang 1 & 2 (Page 05 & Page 06)
      if (page5Barang1) {
        addQuickLabel('OPSI 1', page5Barang1, 90, 115);
        addQuickLabel('DEPAN', page5Barang1, 230, 115);
        addQuickLabel('BELAKANG', page5Barang1, 640, 115);
      }
      if (page6Barang2) {
        addQuickLabel('ATAS', page6Barang2, 160, 115);
        addQuickLabel('DALAM / INNER', page6Barang2, 500, 115);
        addQuickLabel('SAMPING', page6Barang2, 860, 115);
      }

      deselectAll();
      setActivePage(1);
      saveHistory();
    });
  </script>
