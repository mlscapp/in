    function setActivePage(pageElOrNum, event) {
      let targetPage = null;
      if (typeof pageElOrNum === 'number' || typeof pageElOrNum === 'string') {
        targetPage = document.querySelector(`.a4-page[data-page="${pageElOrNum}"]`);
      } else {
        targetPage = pageElOrNum.closest('.a4-page');
      }
      if (!targetPage) return;

      activePageEl = targetPage;
      document.querySelectorAll('.a4-page').forEach(p => {
        p.classList.toggle('active-page', p === activePageEl);
      });

      if (event && !event.target.closest('.canvas-item') && !event.target.closest('#floating-inspector')) {
        deselectAll();
      }
    }

    function movePage(btn, direction, event) {
      if (event) event.stopPropagation();
      const page = btn.closest('.a4-page');
      const workspace = document.getElementById('workspace');
      if (!page || !workspace) return;

      if (direction === -1 && page.previousElementSibling) {
        workspace.insertBefore(page, page.previousElementSibling);
      } else if (direction === 1 && page.nextElementSibling) {
        workspace.insertBefore(page.nextElementSibling, page);
      } else {
        return;
      }

      updatePageNumbers();
      setActivePage(page);
      page.scrollIntoView({ behavior: 'smooth', block: 'center' });
      saveHistory();
    }

    function duplicatePage(btn, event) {
      if (event) event.stopPropagation();
      const page = btn.closest('.a4-page');
      if (!page) return;

      const clone = page.cloneNode(true);
      page.parentNode.insertBefore(clone, page.nextSibling);
      updatePageNumbers();
      rebindAllEvents();
      setActivePage(clone);
      clone.scrollIntoView({ behavior: 'smooth', block: 'center' });
      saveHistory();
    }

    function deletePage(btn, event) {
      if (event) event.stopPropagation();
      const pages = document.querySelectorAll('.a4-page');
      if (pages.length <= 1) {
        alert('Minimal harus tersisa 1 halaman.');
        return;
      }
      const page = btn.closest('.a4-page');
      if (!page) return;
      page.remove();
      updatePageNumbers();
      setActivePage(document.querySelector('.a4-page'));
      saveHistory();
    }

