<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PDF Preview to Client — Molusca Project</title>
  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- html2canvas & jsPDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  <style>
    :root {
      --bg-gradient: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
      --text-primary: #0f172a;
      --text-secondary: #334155;
      --text-muted: #64748b;
      --accent-color: #0f172a;
      --accent-soft: rgba(15, 23, 42, 0.05);
      --border-hairline: rgba(15, 23, 42, 0.12);
      --logo-filter: none;
    }

    * {
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #0d1017;
      color: #f8fafc;
      margin: 0;
      overflow-x: hidden;
      user-select: none;
    }

    .font-mono-ui {
      font-family: 'JetBrains Mono', monospace;
    }

    /* Presisi Ukuran A4 Landscape (297mm x 210mm = 1123px x 794px) */
    .a4-page {
      width: 1123px;
      height: 794px;
      position: relative;
      background: var(--bg-gradient);
      color: var(--text-primary);
      overflow: hidden;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.65);
      transition: background 0.25s ease, color 0.25s ease, outline 0.15s ease;
      flex-shrink: 0;
    }

    .a4-page.active-page {
      outline: 2px solid #3b82f6;
      outline-offset: 4px;
    }

    /* Indikator saat Drag Gambar ke Halaman */
    .a4-page.drag-over {
      outline: 3px dashed #10b981 !important;
      outline-offset: 4px;
    }

    /* Kontrol Halaman (Naik / Turun / Copy / Hapus) */
    .page-controls {
      position: absolute;
      top: 10px;
      right: 14px;
      z-index: 40;
      display: flex;
      align-items: center;
      gap: 4px;
      background: rgba(15, 23, 42, 0.88);
      backdrop-filter: blur(6px);
      padding: 4px 8px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #f8fafc;
      opacity: 0.85;
      transition: opacity 0.18s ease;
    }

    .a4-page:hover .page-controls,
    .a4-page.active-page .page-controls {
      opacity: 1;
    }

    .page-ctrl-btn {
      font-size: 11px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 5px;
      background: rgba(255, 255, 255, 0.1);
      color: #f8fafc;
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .page-ctrl-btn:hover {
      background: rgba(59, 130, 246, 0.85);
    }

    .page-ctrl-btn.danger {
      background: rgba(239, 68, 68, 0.25);
      color: #fca5a5;
    }

    .page-ctrl-btn.danger:hover {
      background: rgba(239, 68, 68, 0.95);
      color: #ffffff;
    }

    /* Layer Background Gambar Custom (JPG/PNG) */
    .page-bg-image {
      position: absolute;
      inset: 0;
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
      pointer-events: none;
      z-index: 1;
    }

    /* Layer Konten Utama */
    .page-content {
      position: relative;
      z-index: 2;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 42px 58px 34px 58px;
    }

    /* Logo Molusca Project */
    .brand-logo {
      height: 34px;
      width: auto;
      object-fit: contain;
      filter: var(--logo-filter);
      display: block;
    }

    /* Sistem Baris Ikon + Teks 100% Sejajar Saat Render PDF */
    .ui-label-row {
      display: flex;
      align-items: center;
      gap: 7px;
      height: 18px;
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .ui-label-row svg {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
      display: block;
    }

    .ui-label-row span {
      display: block;
      line-height: 14px;
    }

    /* Footer Item Sejajar */
    .footer-item {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      height: 18px;
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--text-primary);
    }

    .footer-item svg {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
      display: block;
      opacity: 0.85;
    }

    .footer-item span {
      display: block;
      line-height: 14px;
    }

    /* Hierarki Tipografi Tanpa Card/Kotak */
    .ui-cover-title {
      font-size: 27px;
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.2;
      color: var(--text-primary);
    }

    .ui-value-xl {
      font-size: 18px;
      font-weight: 800;
      letter-spacing: -0.015em;
      line-height: 1.35;
      color: var(--text-primary);
    }

    .ui-value-bold {
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.01em;
      line-height: 1.35;
      color: var(--text-primary);
    }

    .ui-body {
      font-size: 13.5px;
      font-weight: 500;
      color: var(--text-secondary);
      line-height: 1.65;
    }

    /* Aksen Bold Status DP */
    .status-bold-accent {
      border-left: 3.5px solid var(--accent-color);
      padding-left: 10px;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.04em;
      line-height: 1.25;
      color: var(--accent-color);
    }

    /* Pilihan Interaktif (Status Desain ACC & Spesifikasi Hardbox di Rincian Produk) */
    .box-spec-option {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 4px 0;
      cursor: pointer;
      color: var(--text-muted);
      opacity: 0.38;
      border-bottom: 2.5px solid transparent;
      transition: all 0.15s ease;
    }

    .box-spec-option:hover {
      opacity: 0.75;
    }

    .box-spec-option.active {
      color: var(--text-primary);
      font-weight: 800;
      opacity: 1;
      border-bottom-color: var(--accent-color);
    }

    .box-spec-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      border: 1.5px solid currentColor;
      display: inline-block;
      flex-shrink: 0;
    }

    .box-spec-option.active .box-spec-dot {
      background-color: var(--accent-color);
      border-color: var(--accent-color);
    }

    .hairline-b {
      border-bottom: 1px solid var(--border-hairline);
    }

    .hairline-t {
      border-top: 1px solid var(--border-hairline);
    }

    .hairline-r {
      border-right: 1px solid var(--border-hairline);
    }

    /* Layer Freeform (Foto Mockup & Label Posisi/Opsi) */
    .freeform-layer {
      position: absolute;
      inset: 0;
      z-index: 10;
      pointer-events: none;
    }

    .canvas-item {
      position: absolute;
      pointer-events: auto;
      cursor: grab;
      user-select: none;
      border: 1.5px solid transparent;
      border-radius: 4px;
    }

    .canvas-item:hover {
      border-color: rgba(59, 130, 246, 0.5);
    }

    .canvas-item.selected {
      border-color: #3b82f6;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }

    .canvas-item:active {
      cursor: grabbing;
    }

    /* Label Posisi & Opsi di Canvas */
    .canvas-label-text {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-primary);
      padding: 4px 10px;
      border-bottom: 2.5px solid var(--accent-color);
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(2px);
      line-height: 1.2;
      display: inline-block;
      white-space: nowrap;
    }

    .resize-handle {
      display: none;
      position: absolute;
      width: 13px;
      height: 13px;
      background: #3b82f6;
      border: 2px solid #ffffff;
      border-radius: 50%;
      right: -6px;
      bottom: -6px;
      cursor: nwse-resize;
      z-index: 20;
    }

    .delete-badge {
      display: none;
      position: absolute;
      top: -10px;
      right: -10px;
      width: 20px;
      height: 20px;
      background: #ef4444;
      color: #fff;
      border-radius: 50%;
      font-size: 11px;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 20;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    }

    .canvas-item.selected .resize-handle,
    .canvas-item.selected .delete-badge {
      display: flex;
    }

    /* Editable Text Hover/Focus */
    [contenteditable="true"] {
      outline: none;
      cursor: text;
      user-select: text;
      border-radius: 3px;
      transition: background-color 0.12s ease;
    }

    [contenteditable="true"]:hover {
      background-color: var(--accent-soft);
    }

    [contenteditable="true"]:focus {
      background-color: var(--accent-soft);
      box-shadow: 0 0 0 1px var(--accent-color);
    }

    /* Kompensasi Khusus Saat Render html2canvas Agar Presisi */
    .exporting-clean .no-print,
    .exporting-clean .page-controls,
    .exporting-clean .resize-handle,
    .exporting-clean .delete-badge {
      display: none !important;
    }

    .exporting-clean .canvas-item {
      border-color: transparent !important;
      box-shadow: none !important;
    }

    .exporting-clean .a4-page {
      outline: none !important;
      box-shadow: none !important;
    }

    .exporting-clean .ui-label-row span,
    .exporting-clean .footer-item span,
    .exporting-clean .box-spec-option span {
      transform: translateY(-2.5px);
    }

    .exporting-clean .canvas-label-text {
      padding-top: 1px !important;
      padding-bottom: 6px !important;
    }

    @media print {
      @page {
        size: A4 landscape;
        margin: 0;
      }
      body {
        background: #fff;
      }
      #app-toolbar, #floating-inspector, .no-print, .page-controls, .resize-handle, .delete-badge {
        display: none !important;
      }
      #workspace {
        padding: 0 !important;
        gap: 0 !important;
      }
      .a4-page {
        box-shadow: none !important;
        outline: none !important;
        page-break-after: always;
        break-after: page;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col" spellcheck="false">

  <!-- TOP STUDIO TOOLBAR -->
  <header id="app-toolbar" class="sticky top-0 z-50 bg-[#12151e]/95 backdrop-blur-md border-b border-white/10 px-4 py-2.5">
    <div class="max-w-[1680px] mx-auto flex flex-wrap items-center justify-between gap-2.5">
      
      <!-- Info Shortcut -->
      <div class="flex items-center gap-2.5">
        <div class="px-2.5 py-1 rounded bg-white text-slate-950 font-extrabold text-xs tracking-wider">
          MOLUSCA
        </div>
        <div class="text-[11px] text-slate-400 hidden 2xl:block">
          Tarik gambar ke layar · <span class="text-white font-mono-ui">Ctrl+C</span> Copy · <span class="text-white font-mono-ui">Ctrl+V</span> Paste · <span class="text-white font-mono-ui">Ctrl+Z</span> Undo
        </div>
      </div>

      <!-- Tombol Cepat Label Posisi & Opsi 1-4 -->
      <div class="flex flex-wrap items-center gap-1 bg-white/5 p-1 rounded-lg border border-white/10">
        <button onclick="addQuickLabel('DEPAN')" class="px-2 py-1 text-[11px] font-bold rounded bg-white/10 hover:bg-white/20 text-white transition">DEPAN</button>
        <button onclick="addQuickLabel('BELAKANG')" class="px-2 py-1 text-[11px] font-bold rounded bg-white/10 hover:bg-white/20 text-white transition">BELAKANG</button>
        <button onclick="addQuickLabel('KIRI')" class="px-2 py-1 text-[11px] font-bold rounded bg-white/10 hover:bg-white/20 text-white transition">KIRI</button>
        <button onclick="addQuickLabel('KANAN')" class="px-2 py-1 text-[11px] font-bold rounded bg-white/10 hover:bg-white/20 text-white transition">KANAN</button>
        <button onclick="addQuickLabel('ATAS')" class="px-2 py-1 text-[11px] font-bold rounded bg-white/10 hover:bg-white/20 text-white transition">ATAS</button>
        <button onclick="addQuickLabel('BAWAH')" class="px-2 py-1 text-[11px] font-bold rounded bg-white/10 hover:bg-white/20 text-white transition">BAWAH</button>
        <button onclick="addQuickLabel('SAMPING')" class="px-2 py-1 text-[11px] font-bold rounded bg-white/10 hover:bg-white/20 text-white transition">SAMPING</button>
        
        <span class="text-white/20 px-0.5">|</span>

        <button onclick="addQuickLabel('OPSI 1')" class="px-2 py-1 text-[11px] font-bold rounded bg-amber-500/20 hover:bg-amber-500/35 text-amber-200 border border-amber-400/20 transition">OPSI 1</button>
        <button onclick="addQuickLabel('OPSI 2')" class="px-2 py-1 text-[11px] font-bold rounded bg-amber-500/20 hover:bg-amber-500/35 text-amber-200 border border-amber-400/20 transition">OPSI 2</button>
        <button onclick="addQuickLabel('OPSI 3')" class="px-2 py-1 text-[11px] font-bold rounded bg-amber-500/20 hover:bg-amber-500/35 text-amber-200 border border-amber-400/20 transition">OPSI 3</button>
        <button onclick="addQuickLabel('OPSI 4')" class="px-2 py-1 text-[11px] font-bold rounded bg-amber-500/20 hover:bg-amber-500/35 text-amber-200 border border-amber-400/20 transition">OPSI 4</button>

        <button onclick="addQuickLabel('TEXT CUSTOM')" class="px-2.5 py-1 text-[11px] font-bold rounded bg-blue-600 hover:bg-blue-500 text-white transition">+ Text</button>
      </div>

      <!-- Preset Tema Gradasi UI/UX -->
      <div class="flex items-center gap-1.5 bg-white/5 px-2.5 py-1.5 rounded-lg border border-white/10">
        <button onclick="applyTheme('white')" title="Clean White" class="w-4 h-4 rounded-full border border-white/40 bg-gradient-to-br from-white to-slate-200 hover:scale-110 transition"></button>
        <button onclick="applyTheme('blue')" title="Biru" class="w-4 h-4 rounded-full border border-white/20 bg-gradient-to-br from-blue-50 to-blue-200 hover:scale-110 transition"></button>
        <button onclick="applyTheme('sky')" title="Biru Muda" class="w-4 h-4 rounded-full border border-white/20 bg-gradient-to-br from-sky-100 to-cyan-200 hover:scale-110 transition"></button>
        <button onclick="applyTheme('navy')" title="Navy" class="w-4 h-4 rounded-full border border-white/20 bg-gradient-to-br from-slate-900 to-blue-950 hover:scale-110 transition"></button>
        <button onclick="applyTheme('red')" title="Merah" class="w-4 h-4 rounded-full border border-white/20 bg-gradient-to-br from-rose-50 to-red-200 hover:scale-110 transition"></button>
        <button onclick="applyTheme('green')" title="Hijau" class="w-4 h-4 rounded-full border border-white/20 bg-gradient-to-br from-emerald-50 to-teal-200 hover:scale-110 transition"></button>
        <button onclick="applyTheme('gold')" title="Gold" class="w-4 h-4 rounded-full border border-white/20 bg-gradient-to-br from-amber-50 via-yellow-100 to-amber-200 hover:scale-110 transition"></button>
        <button onclick="applyTheme('yellow')" title="Kuning" class="w-4 h-4 rounded-full border border-white/20 bg-gradient-to-br from-yellow-50 to-yellow-200 hover:scale-110 transition"></button>
        <button onclick="applyTheme('orange')" title="Orange" class="w-4 h-4 rounded-full border border-white/20 bg-gradient-to-br from-orange-50 to-orange-200 hover:scale-110 transition"></button>
        <button onclick="applyTheme('brown')" title="Coklat" class="w-4 h-4 rounded-full border border-white/20 bg-gradient-to-br from-stone-100 to-amber-900/30 hover:scale-110 transition"></button>
        <button onclick="applyTheme('black')" title="Hitam" class="w-4 h-4 rounded-full border border-white/40 bg-gradient-to-br from-zinc-900 to-neutral-950 hover:scale-110 transition"></button>
      </div>

      <!-- Tombol Aksi: Foto, Background, Undo/Redo, Tambah Page Barang, Export PDF -->
      <div class="flex items-center gap-1.5">
        <label class="cursor-pointer px-2.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 text-xs font-semibold flex items-center gap-1.5 transition" title="Pilih atau Tarik Gambar Apapun">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          + Foto
          <input type="file" id="photo-input" accept="image/*" multiple class="hidden" onchange="handlePhotoUpload(event)" />
        </label>

        <label class="cursor-pointer px-2.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 text-xs font-semibold flex items-center gap-1.5 transition">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20M2 12h20"/></svg>
          BG Foto
          <input type="file" id="bg-input" accept="image/*" class="hidden" onchange="handleBgUpload(event)" />
        </label>
        <input type="range" id="bg-opacity" min="5" max="100" value="35" title="Opacity Background" oninput="updateBgOpacity(this.value)" class="w-14 accent-blue-500 cursor-pointer" />
        <button onclick="clearCustomBg()" title="Hapus Background Foto" class="p-1.5 rounded-lg bg-white/5 hover:bg-red-500/20 text-slate-400 hover:text-red-300 transition text-xs">✕</button>

        <button onclick="undo()" title="Undo (Ctrl+Z)" class="p-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg>
        </button>
        <button onclick="redo()" title="Redo (Ctrl+Y)" class="p-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 7v6h-6"/><path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3l3 2.7"/></svg>
        </button>

        <button onclick="addMockupPage()" class="px-2.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-xs font-semibold transition">
          + Page Barang
        </button>

        <button id="btn-export-pdf" onclick="exportCleanPDF()" class="px-3.5 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs flex items-center gap-1.5 shadow-lg transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          <span>Download PDF</span>
        </button>
      </div>
    </div>
  </header>

  <!-- FLOATING INSPECTOR BAR -->
  <div id="floating-inspector" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-[#181c26] border border-white/15 rounded-xl px-4 py-2 shadow-2xl items-center gap-3">
    <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Elemen:</span>
    <button onclick="changeSelectedFontSize(-2)" class="px-2 py-1 rounded bg-white/10 hover:bg-white/20 text-xs font-bold">A-</button>
    <button onclick="changeSelectedFontSize(2)" class="px-2 py-1 rounded bg-white/10 hover:bg-white/20 text-xs font-bold">A+</button>
    <button onclick="copySelectedItem()" class="px-2.5 py-1 rounded bg-blue-600/30 hover:bg-blue-600/50 text-blue-200 text-xs font-semibold">Copy (Ctrl+C)</button>
    <button onclick="deleteSelectedItem()" class="px-2.5 py-1 rounded bg-red-500/20 hover:bg-red-500/40 text-red-300 text-xs font-semibold">Hapus (Del)</button>
  </div>

  <!-- WORKSPACE CANVAS A4 LANDSCAPE -->
  <main id="workspace" class="flex-1 flex flex-col items-center py-10 px-4 gap-12 overflow-x-auto">

    <!-- ==========================================================
         PAGE 01 : SAMPUL DOKUMEN (DENGAN STATUS DESAIN: SUDAH ACC / BELUM ACC)
         ========================================================== -->
    <section class="a4-page active-page" data-page="1" onclick="setActivePage(this, event)">
      <div class="page-controls no-print">
        <button class="page-ctrl-btn" onclick="movePage(this, -1, event)" title="Geser Halaman ke Atas">↑ Naik</button>
        <button class="page-ctrl-btn" onclick="movePage(this, 1, event)" title="Geser Halaman ke Bawah">↓ Turun</button>
        <button class="page-ctrl-btn" onclick="duplicatePage(this, event)" title="Duplikat Halaman Ini">⧉ Copy</button>
        <button class="page-ctrl-btn danger" onclick="deletePage(this, event)" title="Hapus Halaman Ini">✕ Hapus</button>
      </div>

      <div class="page-bg-image" style="opacity: 0.35;"></div>
      <div class="freeform-layer"></div>

      <div class="page-content">
        <!-- Header: Logo Resmi Molusca Project -->
        <div class="flex items-center justify-between pb-4 hairline-b">
          <img
            src="https://moluscaproject.com/wp-content/uploads/2016/05/retailer_site_logo288.png"
            alt="Molusca Project"
            class="brand-logo"
            crossorigin="anonymous"
          />
          <div class="text-[11px] font-mono-ui font-bold tracking-[0.2em] uppercase opacity-50" contenteditable="true">
            CLIENT ORDER PREVIEW
          </div>
        </div>

        <!-- Body Sampul -->
