      if (!parentPage) return;
      const groupEl = parentPage.querySelector(`[data-spec-group="${groupName}"]`);
      if (!groupEl) return;

      groupEl.querySelectorAll('.box-spec-option').forEach(opt => {
        opt.classList.toggle('active', opt.dataset.specVal === value);
      });

      saveHistory();
